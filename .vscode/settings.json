{
    // The scripts in src/real_hardware_runs, src/simulator_noise_sources and src/hardware_vs_simulator import code
    // from src/noisy (added to sys.path when they run); this tells Pylance to look in these folders too, so it
    // doesn't mark those imports as unresolved
    "python.analysis.extraPaths": [
        "src/noisy",
        "src/real_hardware_runs",
        "src/hardware_vs_simulator"
    ]
}
